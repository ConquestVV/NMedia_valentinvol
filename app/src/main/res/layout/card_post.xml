<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_post"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="@dimen/common_offset">

    <ImageView
        android:id="@+id/avatar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/netology_48dp" />

    <TextView
        android:id="@+id/author"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/common_offset"
        android:ellipsize="end"
        android:maxLines="1"
        app:layout_constraintStart_toEndOf="@id/avatar"
        app:layout_constraintEnd_toStartOf="@id/more"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="@sample/posts.json/data/author" />

    <TextView
        android:id="@+id/published"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/common_offset"
        app:layout_constraintStart_toEndOf="@id/avatar"
        app:layout_constraintEnd_toStartOf="@id/more"
        app:layout_constraintTop_toBottomOf="@id/author"
        app:layout_constraintBottom_toBottomOf="@id/avatar"
        tools:text="@sample/posts.json/data/published" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/more"
        style="?attr/materialIconButtonStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="More button"
        app:icon="@drawable/baseline_more_vert_24"
        app:iconTint="@color/black"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/topBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="avatar,published" />

    <TextView
        android:id="@+id/content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/common_offset"
        android:autoLink="web"
        app:layout_constraintTop_toBottomOf="@id/topBarrier"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="@sample/posts.json/data/content" />

    <ImageView
        android:id="@+id/attachment"
        android:layout_width="0dp"
        android:layout_height="200dp"
        android:layout_marginTop="@dimen/common_offset"
        android:contentDescription="@string/description_photo"
        android:scaleType="centerCrop"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:src="@drawable/masha_img"
        tools:visibility="visible" />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/bottomBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="content,attachment" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/like_img"
        style="@style/Widget.AppTheme.LikeButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/common_offset"
        android:checkable="true"
        android:minWidth="48dp"
        android:minHeight="48dp"
        app:icon="@drawable/like_img_selector"
        app:layout_constraintTop_toBottomOf="@id/bottomBarrier"
        tools:text="5" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/share_img"
        style="@style/Widget.AppTheme.IconButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/common_offset"
        android:layout_marginTop="@dimen/common_offset"
        android:minWidth="48dp"
        android:minHeight="48dp"
        app:icon="@drawable/share_img_24dp"
        app:iconTint="@color/black"
        app:layout_constraintStart_toEndOf="@id/like_img"
        app:layout_constraintTop_toBottomOf="@id/bottomBarrier"
        tools:text="2" />

    <ImageButton
        android:id="@+id/watchers_img"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/common_offset"
        android:layout_marginEnd="4dp"
        android:background="@android:color/transparent"
        android:contentDescription="icon for watchers"
        android:minWidth="48dp"
        android:minHeight="48dp"
        android:src="@drawable/watchers_img_24dp"
        app:layout_constraintTop_toBottomOf="@id/bottomBarrier"
        app:layout_constraintEnd_toStartOf="@id/watchers_count" />

    <TextView
        android:id="@+id/watchers_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/common_offset"
        app:layout_constraintTop_toBottomOf="@id/bottomBarrier"
        app:layout_constraintBottom_toBottomOf="@id/watchers_img"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="17" />

</androidx.constraintlayout.widget.ConstraintLayout>